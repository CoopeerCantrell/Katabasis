--- !u!114 &3728047285854558932
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2571662101049128671}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\n\n\nFavors: theses are abilities that you have to activate, you get
    these by going in the cave entrance at platforms that look different from the
    regular platforms of Hades\n\nModifiers: theses are passive abilties that tend
    to affect stats of the player or enemies, these are gotten when you complete
    a section of the cave that you are falling though \n\nControls: \r\n\r\nA and
    D to move left to right\r\n\r\nSpacebar to use player ability to slow enemies\r\n\r\nright
    click to use the hero favors you get at the specific ledges that look like they
    are a hole in the wall\n\nEscape/tab to pause the game"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
